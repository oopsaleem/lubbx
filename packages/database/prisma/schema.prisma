datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

generator client {
    provider = "prisma-client-js"
}

generator zod {
    provider         = "zod-prisma-types"
    output           = "./zod"
    createInputTypes = true
    addIncludeType   = false
    addSelectType    = false
}

generator json {
    provider = "prisma-json-types-generator"
}

model User {
    id                 String       @id @default(cuid())
    name               String
    email              String
    emailVerified      Boolean
    image              String?
    createdAt          DateTime
    updatedAt          DateTime
    username           String?
    role               String?
    banned             Boolean?
    banReason          String?
    banExpires         DateTime?
    onboardingComplete Boolean      @default(false)
    paymentsCustomerId String?
    locale             String?
    twoFactorEnabled   Boolean?
    sessions           Session[]
    accounts           Account[]
    passkeys           Passkey[]
    invitations        Invitation[]
    purchases          Purchase[]
    members            Member[]
    twofactors         TwoFactor[]
    aiChats            AiChat[]

    isActive    Boolean          @default(true)
    lastLogin   DateTime?
    permissions UserPermission[]
    employees   Employee[]
    activities  ActivityLog[]

    @@unique([email])
    @@unique([username])
    @@index([role])
    @@index([isActive])
    @@map("user")
}

model Session {
    id        String   @id @default(cuid())
    expiresAt DateTime
    ipAddress String?
    userAgent String?
    userId    String
    user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

    impersonatedBy String?

    activeOrganizationId String?

    token     String
    createdAt DateTime
    updatedAt DateTime

    @@unique([token])
    @@map("session")
}

model Account {
    id           String    @id @default(cuid())
    accountId    String
    providerId   String
    userId       String
    user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
    accessToken  String?   @db.Text
    refreshToken String?   @db.Text
    idToken      String?   @db.Text
    expiresAt    DateTime?
    password     String?

    accessTokenExpiresAt  DateTime?
    refreshTokenExpiresAt DateTime?
    scope                 String?
    createdAt             DateTime
    updatedAt             DateTime

    @@map("account")
}

model Verification {
    id         String   @id @default(cuid())
    identifier String
    value      String   @db.Text
    expiresAt  DateTime

    createdAt DateTime?
    updatedAt DateTime?

    @@map("verification")
}

model Passkey {
    id           String    @id @default(cuid())
    name         String?
    publicKey    String
    userId       String
    user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
    credentialID String
    counter      Int
    deviceType   String
    backedUp     Boolean
    transports   String?
    createdAt    DateTime?

    @@map("passkey")
}

model TwoFactor {
    id          String @id @default(cuid())
    secret      String
    backupCodes String
    userId      String
    user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@map("twoFactor")
}

model Organization {
    id                 String       @id @default(cuid())
    name               String
    slug               String?
    logo               String?
    createdAt          DateTime
    metadata           String?
    paymentsCustomerId String?
    farm               Farm?
    members            Member[]
    invitations        Invitation[]
    purchases          Purchase[]
    aiChats            AiChat[]

    @@unique([slug])
    @@map("organization")
}

model Member {
    id             String       @id @default(cuid())
    organizationId String
    organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
    userId         String
    user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
    role           String
    createdAt      DateTime

    @@unique([organizationId, userId])
    @@map("member")
}

model Invitation {
    id             String       @id @default(cuid())
    organizationId String
    organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
    email          String
    role           String?
    status         String
    expiresAt      DateTime
    inviterId      String
    user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

    @@map("invitation")
}

enum PurchaseType {
    SUBSCRIPTION
    ONE_TIME
}

model Purchase {
    id             String        @id @default(cuid())
    organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
    organizationId String?
    user           User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
    userId         String?
    type           PurchaseType
    customerId     String
    subscriptionId String?       @unique
    productId      String
    status         String?
    createdAt      DateTime      @default(now())
    updatedAt      DateTime      @updatedAt

    @@index([subscriptionId])
    @@map("purchase")
}

model AiChat {
    id             String        @id @default(cuid())
    organizationId String?
    organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
    userId         String?
    user           User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
    title          String?
    /// [Array<{role: "user" | "assistant"; content: string;}>]
    messages       Json          @default("[]") /// @zod.custom.use(z.array(z.object({ role: z.enum(['user', 'assistant']), content: z.string() })))
    createdAt      DateTime      @default(now())
    updatedAt      DateTime      @updatedAt

    @@map("ai_chat")
}

// ==================== FARM

// ==================== المستخدمون والصلاحيات ====================
enum UserRole {
    admin
    user
    manager
    employee
    viewer
}

model UserPermission {
    id        String  @id @default(cuid())
    userId    String
    module    String
    canView   Boolean @default(false)
    canCreate Boolean @default(false)
    canEdit   Boolean @default(false)
    canDelete Boolean @default(false)

    user User @relation(fields: [userId], references: [id])

    @@unique([userId, module])
    @@index([userId])
    @@index([module])
}

// ==================== المزرعة الأساسية ====================
model Farm {
    id           String       @id @default(cuid())
    name         String       @unique
    ownerName    String?
    location     String?
    description  String?
    organization Organization @relation(fields: [id], references: [id])

    // العلاقات
    livestock     Livestock[]
    pens          Pen[]
    healthRecords HealthRecord[]
    expenses      Expense[]
    incomes       Income[]
    feeds         Feed[]
    activities    ActivityLog[]
    employees     Employee[]
    equipment     Equipment[]
    productions   DailyProduction[]
    births        BirthRecord[]
    settings      SystemSettings?

    createdAt        DateTime          @default(now())
    updatedAt        DateTime          @updatedAt
    scheduledReports ScheduledReport[]

    @@index([name])
    @@index([ownerName])
    @@map("farm")
}

// ==================== إدارة المواشي ====================
enum LivestockStatus {
    ACTIVE
    SOLD
    DECEASED
    QUARANTINED
    PREGNANT // حامل - إضافة جديدة
}

enum LivestockGender {
    MALE
    FEMALE
}

enum LivestockType {
    CATTLE
    SHEEP
    GOAT
    CAMEL
    POULTRY
}

model Livestock {
    id            String          @id @default(cuid())
    tagNumber     String          @unique
    type          LivestockType
    lineage       String?
    gender        LivestockGender
    dateOfBirth   DateTime?
    purchaseDate  DateTime        @default(now())
    purchasePrice Float?
    weight        Float?
    status        LivestockStatus @default(ACTIVE)
    penId         String?
    farmId        String

    // معلومات النسب
    fatherTag String?
    motherTag String?

    // العلاقات
    pen            Pen?                   @relation(fields: [penId], references: [id])
    farm           Farm                   @relation(fields: [farmId], references: [id])
    healthRecords  HealthRecord[]
    feedRecords    FeedRecord[]
    transactions   LivestockTransaction[]
    productions    DailyProduction[]
    birthsAsMother BirthRecord[]          @relation("MotherBirths")
    birthsAsCalf   BirthRecord[]          @relation("CalfBirths")

    createdAt        DateTime          @default(now())
    updatedAt        DateTime          @updatedAt
    vaccinations     Vaccination[]
    pregnancyRecords PregnancyRecord[]

    @@index([tagNumber])
    @@index([status])
    @@index([farmId])
    @@index([type])
    @@index([gender])
    @@index([penId])
    @@index([purchaseDate])
}

// ==================== الحظائر والأقسام ====================
model Pen {
    id          String  @id @default(cuid())
    name        String
    code        String  @unique
    capacity    Int
    location    String?
    description String?
    farmId      String

    // العلاقات
    farm      Farm        @relation(fields: [farmId], references: [id])
    livestock Livestock[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([farmId])
    @@index([code])
}

// ==================== إدارة الصحة والعلاج ====================
enum HealthStatus {
    HEALTHY
    SICK
    INJURED
    RECOVERING
    UNDER_OBSERVATION // تحت المراقبة
}

enum TreatmentType {
    VACCINATION
    MEDICATION
    SURGERY
    CHECKUP
    DEWORMING // تطهير من الديدان
    DENTAL // علاج أسنان
}

model HealthRecord {
    id          String       @id @default(cuid())
    livestockId String
    recordDate  DateTime     @default(now())
    status      HealthStatus
    symptoms    String?
    diagnosis   String?
    temperature Float?
    weight      Float?

    treatmentType TreatmentType?
    medicineName  String?
    dosage        String?
    vetName       String?
    cost          Float?

    nextCheckup DateTime?
    notes       String?
    farmId      String

    // العلاقات
    livestock Livestock @relation(fields: [livestockId], references: [id])
    farm      Farm      @relation(fields: [farmId], references: [id])

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([livestockId])
    @@index([recordDate])
    @@index([status])
    @@index([farmId])
    @@index([nextCheckup])
    @@index([treatmentType])
}

model Vaccination {
    id             String   @id @default(cuid())
    livestockId    String
    vaccineName    String
    dateGiven      DateTime @default(now())
    nextDueDate    DateTime
    administeredBy String?
    notes          String?

    livestock Livestock @relation(fields: [livestockId], references: [id])

    @@index([livestockId])
    @@index([dateGiven])
    @@index([nextDueDate])
    @@index([vaccineName])
}

// ==================== إدارة التغذية ====================
model Feed {
    id          String  @id @default(cuid())
    name        String
    type        String
    unit        String  @default("كيلوغرام")
    unitPrice   Float
    stock       Float   @default(0)
    minStock    Float?
    description String?
    farmId      String

    // العلاقات
    farm        Farm         @relation(fields: [farmId], references: [id])
    feedRecords FeedRecord[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([farmId])
    @@index([type])
    @@index([name])
}

model FeedRecord {
    id          String   @id @default(cuid())
    livestockId String
    feedId      String
    quantity    Float
    feedingDate DateTime @default(now())
    timeOfDay   String?
    notes       String?

    // العلاقات
    livestock Livestock @relation(fields: [livestockId], references: [id])
    feed      Feed      @relation(fields: [feedId], references: [id])

    createdAt DateTime @default(now())

    @@unique([livestockId, feedId, feedingDate, timeOfDay])
    @@index([livestockId])
    @@index([feedId])
    @@index([feedingDate])
}

// ==================== إدارة المصروفات والمالية ====================
enum ExpenseCategory {
    FEED // علف
    HEALTHCARE // رعاية صحية
    LABOR // عمالة
    UTILITIES // مرافق
    EQUIPMENT // معدات
    MAINTENANCE // صيانة
    TRANSPORTATION // نقل
    INSURANCE // تأمين
    OTHER // أخرى
}

enum IncomeCategory {
    LIVESTOCK_SALE // بيع مواشي
    MEAT_PRODUCTION // إنتاج لحوم
    WOOL_PRODUCTION // إنتاج صوف
    MILK_PRODUCTION // إنتاج حليب
    OTHER_PRODUCTS // منتجات أخرى
    SUBSIDY // دعم حكومي
    OTHER // أخرى
}

model Expense {
    id          String          @id @default(cuid())
    farmId      String
    category    ExpenseCategory
    description String
    amount      Float
    date        DateTime        @default(now())
    receiptNo   String?
    paidTo      String?
    employeeId  String? // الموظف المسؤول عن المصروف
    notes       String?

    // العلاقات
    farm     Farm      @relation(fields: [farmId], references: [id])
    employee Employee? @relation(fields: [employeeId], references: [id])

    createdAt DateTime @default(now())

    @@index([farmId])
    @@index([category])
    @@index([date])
    @@index([employeeId])
}

model Income {
    id           String         @id @default(cuid())
    farmId       String
    category     IncomeCategory
    description  String
    amount       Float
    date         DateTime       @default(now())
    receivedFrom String?
    notes        String?

    // العلاقات
    farm Farm @relation(fields: [farmId], references: [id])

    createdAt DateTime @default(now())

    @@index([farmId])
    @@index([category])
    @@index([date])
}

// ==================== عمليات البيع والشراء ====================
enum TransactionType {
    PURCHASE // شراء
    SALE // بيع
    TRADE // مقايضة
}

enum PaymentMethod {
    CASH
    BANK_TRANSFER
    CHECK
    CREDIT
}

model LivestockTransaction {
    id              String          @id @default(cuid())
    livestockId     String
    transactionType TransactionType
    transactionDate DateTime        @default(now())
    price           Float
    buyerSeller     String? // المشتري/البائع
    paymentMethod   PaymentMethod? // طريقة الدفع
    notes           String?

    // العلاقات
    livestock Livestock @relation(fields: [livestockId], references: [id])

    createdAt DateTime @default(now())

    @@index([livestockId])
    @@index([transactionDate])
    @@index([transactionType])
    @@index([buyerSeller])
}

// ==================== الموظفين والرواتب ====================
enum EmployeePosition {
    MANAGER // مدير
    VETERINARIAN // طبيب بيطري
    CARETAKER // راعٍ
    FEEDER // مقدم علف
    CLEANER // عامل نظافة
    DRIVER // سائق
    OTHER
}

model Employee {
    id       String           @id @default(cuid())
    name     String
    position EmployeePosition
    phone    String?
    email    String?
    address  String?
    salary   Float // الراتب الشهري
    hireDate DateTime         @default(now())
    isActive Boolean          @default(true)
    farmId   String
    userId   String? // إذا كان لديه حساب مستخدم

    // العلاقات
    farm     Farm            @relation(fields: [farmId], references: [id])
    user     User?           @relation(fields: [userId], references: [id])
    salaries SalaryPayment[]
    expenses Expense[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([farmId])
    @@index([position])
    @@index([isActive])
    @@index([hireDate])
}

model SalaryPayment {
    id          String   @id @default(cuid())
    employeeId  String
    amount      Float
    paymentDate DateTime @default(now())
    month       String // مثال: "2024-01"
    year        Int
    notes       String?

    employee Employee @relation(fields: [employeeId], references: [id])

    @@unique([employeeId, month, year])
    @@index([employeeId])
    @@index([paymentDate])
    @@index([month, year])
}

// ==================== المعدات والصيانة ====================
enum EquipmentStatus {
    OPERATIONAL // يعمل
    MAINTENANCE // تحت الصيانة
    OUT_OF_ORDER // معطل
    RETIRED // معتق
}

model Equipment {
    id            String          @id @default(cuid())
    name          String
    serialNumber  String?         @unique
    type          String // نوع المعدة
    purchaseDate  DateTime?
    purchasePrice Float?
    status        EquipmentStatus @default(OPERATIONAL)
    location      String?
    farmId        String

    // العلاقات
    farm        Farm                @relation(fields: [farmId], references: [id])
    maintenance MaintenanceRecord[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([farmId])
    @@index([status])
    @@index([type])
}

model MaintenanceRecord {
    id              String    @id @default(cuid())
    equipmentId     String
    maintenanceDate DateTime  @default(now())
    type            String // نوع الصيانة (وقائية، تصليح)
    description     String
    cost            Float?
    technician      String?
    nextMaintenance DateTime?

    equipment Equipment @relation(fields: [equipmentId], references: [id])

    @@index([equipmentId])
    @@index([maintenanceDate])
    @@index([nextMaintenance])
}

// ==================== الإنتاج اليومي ====================
enum ProductionType {
    MILK // حليب
    EGGS // بيض
    WOOL // صوف
    HONEY // عسل
    OTHER
}

enum Unit {
    LITER // ليتر
    KG // كيلوغرام
    PIECE // قطعة
    OTHER
}

model DailyProduction {
    id             String         @id @default(cuid())
    livestockId    String?
    productionType ProductionType
    quantity       Float
    unit           Unit           @default(LITER)
    productionDate DateTime       @default(now())
    qualityNotes   String?
    farmId         String

    // العلاقات
    livestock Livestock? @relation(fields: [livestockId], references: [id])
    farm      Farm       @relation(fields: [farmId], references: [id])

    createdAt DateTime @default(now())

    @@unique([livestockId, productionDate, productionType])
    @@index([livestockId])
    @@index([productionDate])
    @@index([productionType])
    @@index([farmId])
}

// ==================== الحمل والولادة ====================
model BirthRecord {
    id             String   @id @default(cuid())
    motherId       String // الأم
    calfId         String? // المولود (إذا تم تسجيله)
    birthDate      DateTime @default(now())
    birthType      String? // نوع الولادة (طبيعية، قيصرية)
    numberOfCalves Int      @default(1) // عدد المواليد
    weightAtBirth  Float? // الوزن عند الولادة
    notes          String?
    farmId         String

    // العلاقات
    mother Livestock  @relation("MotherBirths", fields: [motherId], references: [id])
    calf   Livestock? @relation("CalfBirths", fields: [calfId], references: [id])
    farm   Farm       @relation(fields: [farmId], references: [id])

    createdAt DateTime @default(now())

    @@index([motherId])
    @@index([birthDate])
    @@index([farmId])
}

// ==================== الحوامل ====================
model PregnancyRecord {
    id                 String    @id @default(cuid())
    expectedBirthDate  DateTime? // تاريخ الولادة المتوقع
    pregnancyNotedDate DateTime  @default(now()) // تاريخ ملاحظة الحمل
    isPregnant         Boolean? // هل حامل؟
    notes              String?

    createdAt   DateTime   @default(now())
    livestock   Livestock? @relation(fields: [livestockId], references: [id])
    livestockId String?

    @@unique([livestockId])
    @@index([expectedBirthDate])
}

// ==================== سجل النشاطات ====================
model ActivityLog {
    id        String   @id @default(cuid())
    createdAt DateTime @default(now())
    userId    String
    farmId    String
    action    String // العملية التي تمت
    module    String // القسم الذي حدثت فيه العملية
    details   Json? // تفاصيل إضافية
    ipAddress String?
    userAgent String?

    // العلاقات
    user User @relation(fields: [userId], references: [id])
    farm Farm @relation(fields: [farmId], references: [id])

    @@index([userId])
    @@index([farmId])
    @@index([createdAt])
    @@index([module])
}

// ==================== الإعدادات ====================
model SystemSettings {
    id         String @id @default(cuid())
    farmId     String @unique
    currency   String @default("ريال سعودي")
    language   String @default("ar")
    timezone   String @default("Asia/Riyadh")
    dateFormat String @default("dd/MM/yyyy")

    // إعدادات التنبيهات
    healthAlerts    Boolean @default(true)
    feedAlerts      Boolean @default(true)
    financialAlerts Boolean @default(true)
    breedingAlerts  Boolean @default(true) // تنبيهات التكاثر

    // إعدادات المزرعة
    automaticWeightTracking Boolean @default(false)
    milkProductionTracking  Boolean @default(true)
    enableBreedingModule    Boolean @default(true)

    farm Farm @relation(fields: [farmId], references: [id])

    updatedAt DateTime @updatedAt
}

// ==================== جدول للتقارير المجدولة ====================
model ScheduledReport {
    id         String    @id @default(cuid())
    farmId     String
    reportType String // نوع التقرير
    frequency  String // التكرار (يومي، أسبوعي، شهري)
    recipients String[] // قائمة بريدية للمستلمين
    isActive   Boolean   @default(true)
    lastSent   DateTime?
    nextSend   DateTime?

    farm Farm @relation(fields: [farmId], references: [id])

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([farmId])
    @@index([reportType])
    @@index([nextSend])
    @@index([isActive])
}
